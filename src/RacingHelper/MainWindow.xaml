<Window x:Class="RacingHelper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Racing Helper" Width="1400" Height="900" MinWidth="900" MinHeight="600"
        Background="#0B0E13" WindowStartupLocation="CenterScreen">
    <Grid>
        <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#0B0E13" />
        <StackPanel x:Name="Fallback" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Foreground="#E8ECF2" FontSize="20" FontFamily="Segoe UI Semibold" Text="Racing Helper is running" HorizontalAlignment="Center" />
            <TextBlock x:Name="FallbackText" Foreground="#8A94A6" FontSize="14" Margin="0,10,0,16" TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center" />
            <Button x:Name="OpenBrowser" Content="Open dashboard in browser" Padding="16,8" HorizontalAlignment="Center" Click="OpenBrowser_Click" />
        </StackPanel>
    </Grid>
</Window>
